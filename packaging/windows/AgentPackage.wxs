<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="bazUSOP Agent"
    Manufacturer="bazUSOP"
    Version="$(var.Version)"
    UpgradeCode="5D0DC76D-9CA3-448A-965B-A2C506509706"
    Language="1055"
    Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="Daha yeni bir bazUSOP Agent sürümü zaten kurulu." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="bazUSOP">
        <Component Id="AgentExecutable" Guid="170308B8-4240-49E7-8115-E583BA375878" Bitness="always64">
          <File Id="AgentExe" Source="$(var.SourceDir)\bazusop-agent.exe" KeyPath="yes" />
          <ServiceInstall
            Id="AgentServiceInstall"
            Name="bazusop-agent"
            DisplayName="bazUSOP Agent"
            Description="bazUSOP hub'ına güvenli outbound bağlantı kuran host agent'ı"
            Type="ownProcess"
            Start="auto"
            ErrorControl="normal"
            Account="LocalSystem" />
          <ServiceControl
            Id="AgentServiceControl"
            Name="bazusop-agent"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramDataFolder">
      <Directory Id="BazusopDataFolder" Name="bazUSOP">
        <Directory Id="AgentStateFolder" Name="agent">
          <Component Id="AgentState" Guid="48D7F092-02A5-4F44-9F62-60130B3F0265" Bitness="always64">
            <CreateFolder />
            <Environment Id="AgentStateEnvironment" Name="BAZUSOP_AGENT_STATE_DIR" Value="[AgentStateFolder]" System="yes" Action="set" Part="all" />
            <RegistryValue Root="HKLM" Key="Software\bazUSOP\Agent" Name="StateDirectory" Value="[AgentStateFolder]" Type="string" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="bazUSOP Agent" Level="1">
      <ComponentRef Id="AgentExecutable" />
      <ComponentRef Id="AgentState" />
    </Feature>
  </Package>
</Wix>
